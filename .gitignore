# ============================================================
# .gitignore — Scrapper & Analysis Monorepo
# ============================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.history/
*.code-workspace

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# PYTHON / BACKEND
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
myenv/
.env_backup/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/

# Test & coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter Notebooks
.ipynb_checkpoints

# Celery
celerybeat-schedule
celerybeat.pid

# ============================================================
# DATABASES
# ============================================================

*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# ============================================================
# PLAYWRIGHT / TEST ARTIFACTS
# ============================================================

test-results/
playwright-report/
blob-report/
test-results.json
/test-results/
/playwright/.cache/

# ============================================================
# NODE / NEXT.JS / FRONTEND
# ============================================================

node_modules/
.next/
out/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Yarn
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# pnpm
.pnpm-store/

# Build output
build/
dist/
.cache/

# ============================================================
# ENVIRONMENT / SECRETS — NEVER COMMIT
# ============================================================

.env
.env.*
!.env.example          # keep the template
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================================
# SCRATCH / TEMPORARY
# ============================================================

scratch/
*.tmp
*.temp
*.bak
*.orig
*.rej

# ============================================================
# MISC
# ============================================================

# Python profiling
*.prof

# Coverage reports
lcov.info

# Lock files (keep package-lock.json but ignore others if needed)
# yarn.lock  # uncomment if you want to ignore yarn lock

# Windows specific
*.lnk